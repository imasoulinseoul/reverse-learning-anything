{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "language",
    "sources",
    "lessons",
    "subject"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "locator"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "locator": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "estimatedMinutes",
          "concept",
          "sourceRefs",
          "questions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "estimatedMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "concept": {
            "$ref": "#/$defs/text"
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "choices",
                    "correctChoiceId"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "multipleChoice"
                    },
                    "choices": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "text"
                        ],
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/id"
                          },
                          "text": {
                            "$ref": "#/$defs/text"
                          }
                        }
                      }
                    },
                    "correctChoiceId": {
                      "$ref": "#/$defs/id"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "choices",
                    "correctChoiceIds"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "multipleSelect"
                    },
                    "choices": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "text"
                        ],
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/id"
                          },
                          "text": {
                            "$ref": "#/$defs/text"
                          }
                        }
                      }
                    },
                    "correctChoiceIds": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "correctAnswer"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "trueFalse"
                    },
                    "correctAnswer": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "acceptedAnswers"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "shortAnswer"
                    },
                    "acceptedAnswers": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "acceptedAnswers"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "fillBlank"
                    },
                    "acceptedAnswers": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "items",
                    "correctOrder"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "ordering"
                    },
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "text"
                        ],
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/id"
                          },
                          "text": {
                            "$ref": "#/$defs/text"
                          }
                        }
                      }
                    },
                    "correctOrder": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "pairs"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "matching"
                    },
                    "pairs": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "left",
                          "right"
                        ],
                        "properties": {
                          "id": {
                            "$ref": "#/$defs/id"
                          },
                          "left": {
                            "$ref": "#/$defs/text"
                          },
                          "right": {
                            "$ref": "#/$defs/text"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "answer"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "flashcard"
                    },
                    "answer": {
                      "$ref": "#/$defs/text"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "prompt",
                    "explanation",
                    "sourceRefs",
                    "type",
                    "code",
                    "codeLanguage",
                    "acceptedAnswers"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/id"
                    },
                    "prompt": {
                      "$ref": "#/$defs/text"
                    },
                    "explanation": {
                      "$ref": "#/$defs/text"
                    },
                    "sourceRefs": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/id"
                      }
                    },
                    "type": {
                      "const": "codeCompletion"
                    },
                    "code": {
                      "$ref": "#/$defs/text"
                    },
                    "codeLanguage": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "acceptedAnswers": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 20,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "subject": {
      "enum": [
        "language",
        "softwareEngineering",
        "generalStudy",
        "other"
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imasoulinseoul.github.io/reverse-learning-anything/schemas/learning-pack.schema.json",
  "title": "Reverse Learning Anything pack v2",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    }
  }
}
