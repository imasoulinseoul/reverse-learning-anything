{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "language",
    "sources",
    "lessons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "locator"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "locator": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "title",
          "estimatedMinutes",
          "concept",
          "sourceRefs",
          "questions"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "estimatedMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "concept": {
            "$ref": "#/$defs/text"
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "prompt",
                "choices",
                "correctChoiceId",
                "explanation",
                "sourceRefs"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "type": {
                  "const": "multipleChoice"
                },
                "prompt": {
                  "$ref": "#/$defs/text"
                },
                "choices": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "text"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "text": {
                        "$ref": "#/$defs/text"
                      }
                    }
                  }
                },
                "correctChoiceId": {
                  "$ref": "#/$defs/id"
                },
                "explanation": {
                  "$ref": "#/$defs/text"
                },
                "sourceRefs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imasoulinseoul.github.io/reverse-learning/schemas/learning-pack.schema.json",
  "title": "Reverse Learning pack v1",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    }
  }
}
